# Raíz — ejemplo para `docker compose up`. CERO secretos reales en el repo.
DATABASE_URL=postgresql+psycopg://odonto:odonto@postgres:5432/odonto
REDIS_URL=redis://redis:6379/0
# Clave de firma JWT HS256: SECRETO de 32+ caracteres generado por entorno
# (sin default demo; el default changeme-* bloquea el arranque en production).
JWT_SECRET=cambiame-genera-secreto-aleatorio-de-32-o-mas-caracteres
# Jornada plena de recepción (KB 08): 720 minutos = 12 h de sesión.
JWT_EXPIRE_MIN=720
WA_TOKEN=
WA_PHONE_ID=
WA_WEBHOOK_VERIFY=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
TENANT_DEFAULT_CANCEL_HS=12
LISTA_ESPERA_OFERTA_MIN=60
FACTURADOR_MODO=manual
ARCA_CUIT=
ARCA_CERT_PATH=
ARCA_KEY_PATH=
ARCA_WSFE_URL=
CORS_ORIGINS=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173
PRE_RESERVA_TTL_MIN=10
REPROGRAMACION_MIN_HORAS=12
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PUBLIC_WINDOW_S=60
RATE_LIMIT_PUBLIC_READ_MAX=120
RATE_LIMIT_PUBLIC_WRITE_MAX=10# Jornada del portal público (C-06): grilla de slots y horario de atención.
PUBLIC_SLOT_START=08:00
PUBLIC_SLOT_END=20:00
PUBLIC_SLOT_GRID_MIN=30
# Teléfono receptor para Click-to-Chat de WhatsApp (supuesto de demo).
WHATSAPP_CONSULTORIO=5491100000000
# Frontend (ex frontend/.env.example)
VITE_API_URL=http://localhost:8000
VITE_WHATSAPP_CONSULTORIO=5491100000000
