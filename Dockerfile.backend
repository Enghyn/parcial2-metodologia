FROM python:3.12-slim
WORKDIR /srv
COPY pyproject.toml ./
RUN pip install --no-cache-dir -e . 2>/dev/null || pip install --no-cache-dir fastapi "uvicorn[standard]" sqlalchemy alembic "psycopg[binary]" pydantic-settings redis rq mercadopago
COPY src/backend ./src/backend
ENV PYTHONPATH=/srv/src/backend
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
